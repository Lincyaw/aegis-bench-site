{
  "name": "aegis-bench-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:css": "stylelint \"src/**/*.css\"",
    "check:locale": "node scripts/check-locale.ts",
    "check:data": "tsx scripts/check-data.ts",
    "check": "tsc -b && npm run lint && npm run lint:css && npm run check:locale && npm run check:data",
    "preview": "vite preview",
    "gen": "tsp compile spec && openapi-typescript src/api/openapi.json --enum-values -o src/api/schema.ts",
    "mock": "npm run gen && tsx scripts/mock-server.ts",
    "predev": "npm run gen",
    "prebuild": "npm run gen"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.108.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "animejs": "^4.5.0",
    "clsx": "^2.1.1",
    "dereference-json-schema": "^0.2.3",
    "i18next": "^27.2.6",
    "msw": "^3.0.7",
    "negotiator": "^1.1.0",
    "openapi-backend": "^5.26.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-i18next": "^18.0.3",
    "react-router-dom": "^7.18.6",
    "remark-parse": "^11.0.0",
    "three": "^0.187.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.11",
    "@hono/swagger-ui": "^0.6.2",
    "@mdx-js/rollup": "^3.1.1",
    "@stefanprobst/rehype-extract-toc": "^3.0.0",
    "@types/mdx": "^2.0.14",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@typespec/compiler": "^1.18.0",
    "@typespec/http": "^1.18.0",
    "@typespec/json-schema": "^1.18.0",
    "@typespec/openapi3": "^1.18.0",
    "@vitejs/plugin-react": "^6.1.2",
    "hono": "^4.13.21",
    "openapi-msw": "^2.1.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2008",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^8.3.6"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
