{
  "name": "aegis-bench-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "gen": "tsp compile spec && openapi-typescript generated/openapi.yaml --enum-values -o src/api/schema.ts",
    "predev": "npm run gen",
    "prebuild": "npm run gen"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.4.1",
    "@tanstack/react-query": "^5.108.4",
    "animejs": "^4.5.0",
    "msw": "^3.0.7",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@typespec/compiler": "^1.18.0",
    "@typespec/http": "^1.18.0",
    "@typespec/openapi3": "^1.18.0",
    "@vitejs/plugin-react": "^6.1.2",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.90.0",
    "typescript": "~5.9",
    "vite": "^8.3.6"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
