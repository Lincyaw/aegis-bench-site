// Agent Trajectory Interchange Format, ATIF-v1.8, as defined by Harbor's reference models (harbor.models.trajectories).
namespace ATIF;

union SchemaVersion {
  "ATIF-v1.0",
  "ATIF-v1.1",
  "ATIF-v1.2",
  "ATIF-v1.3",
  "ATIF-v1.4",
  "ATIF-v1.5",
  "ATIF-v1.6",
  "ATIF-v1.7",
  "ATIF-v1.8",
}

/** Agent configuration. */
model Agent {
  /** The name of the agent system */
  name: string;

  /** The version identifier of the agent system */
  version: string;

  /** Default LLM model used for this trajectory */
  model_name?: string;

  /** Tool definitions available to the agent, each following OpenAI's function calling schema */
  tool_definitions?: Record<unknown>[];

  /** Custom agent configuration details */
  extra?: Record<unknown>;
}

/** Image stored as a file or at a remote URL. */
model ImageSource {
  media_type: "image/jpeg" | "image/png" | "image/gif" | "image/webp";

  /** Relative or absolute file path, or a URL */
  path: string;
}

/** Audio stored as a file or at a remote URL; added in ATIF-v1.8. */
model AudioSource {
  media_type:
    | "audio/wav"
    | "audio/mpeg"
    | "audio/mp4"
    | "audio/aac"
    | "audio/ogg"
    | "audio/flac"
    | "audio/webm"
    | "audio/aiff";

  /** Relative or absolute file path, or a URL */
  path: string;

  /** Duration of the audio in seconds */
  @minValue(0)
  duration_sec?: float64;
}

model TextPart {
  type: "text";
  text: string;
}

model ImagePart {
  type: "image";
  source: ImageSource;
}

model AudioPart {
  type: "audio";
  source: AudioSource;
}

/** A single part of a multimodal message; plain strings remain valid for text-only content. */
@discriminated(#{ envelope: "none", discriminatorPropertyName: "type" })
union ContentPart {
  text: TextPart,
  image: ImagePart,
  audio: AudioPart,
}

/** A tool call within a step. */
model ToolCall {
  /** Unique identifier for this specific tool call */
  tool_call_id: string;

  /** The name of the function or tool being invoked */
  function_name: string;

  /** Arguments passed to the function (can be empty) */
  arguments: Record<unknown>;

  /** Custom tool-call-level metadata */
  extra?: Record<unknown>;
}

/** Reference to a delegated subagent trajectory; at least one of trajectory_id or trajectory_path is set. */
model SubagentTrajectoryRef {
  /** Matches Trajectory.trajectory_id of an entry in the parent's subagent_trajectories */
  trajectory_id?: string;

  /** Run identity of the subagent; informational only, never a resolution key */
  session_id?: string;

  /** Location of an external subagent trajectory file */
  trajectory_path?: string;

  extra?: Record<unknown>;
}

/** A single result within an observation. */
model ObservationResult {
  /** The tool_call_id this result corresponds to; omitted for actions outside tool calling */
  source_call_id?: string;

  content?: string | ContentPart[];
  subagent_trajectory_ref?: SubagentTrajectoryRef[];
  extra?: Record<unknown>;
}

/** Environment feedback after actions or system events. */
model Observation {
  results: ObservationResult[];
}

/** LLM operational and confidence data for one step. */
model Metrics {
  /** Total input tokens including cached and non-cached */
  prompt_tokens?: int32;

  /** Total tokens generated by the LLM response */
  completion_tokens?: int32;

  /** Subset of prompt_tokens that were cache hits */
  cached_tokens?: int32;

  /** Monetary cost of the API call in USD */
  cost_usd?: float64;

  prompt_token_ids?: int32[];
  completion_token_ids?: int32[];
  logprobs?: float64[];
  extra?: Record<unknown>;
}

/** Aggregate statistics for the entire trajectory. */
model FinalMetrics {
  total_prompt_tokens?: int32;
  total_completion_tokens?: int32;
  total_cached_tokens?: int32;

  /** Total real monetary cost, including subagents */
  total_cost_usd?: float64;

  @minValue(0)
  total_steps?: int32;

  extra?: Record<unknown>;
}

union StepSource {
  "system",
  "user",
  "agent",
}

/**
 * A single step. model_name, reasoning_effort, reasoning_content, tool_calls and metrics
 * are only present when source is "agent".
 */
model Step {
  /** Ordinal index of the turn, sequential from 1 */
  @minValue(1)
  step_id: int32;

  /** ISO 8601 timestamp of when this step occurred */
  timestamp?: utcDateTime;

  source: StepSource;
  model_name?: string;
  reasoning_effort?: string | float64;
  message: string | ContentPart[];
  reasoning_content?: string;
  tool_calls?: ToolCall[];
  observation?: Observation;
  metrics?: Metrics;

  /** Whether the step was copied from a previous trajectory for context */
  is_copied_context?: boolean;

  /** Number of LLM inferences this step represents; 0 marks a deterministic dispatch */
  @minValue(0)
  llm_call_count?: int32;

  extra?: Record<unknown>;
}

/** Agent trajectory in ATIF. */
model Trajectory {
  schema_version?: SchemaVersion = "ATIF-v1.8";

  /** Identifier of the agent run this trajectory belongs to */
  session_id?: string;

  /** Identifier of this trajectory document; required on embedded subagent trajectories */
  trajectory_id?: string;

  agent: Agent;

  @minItems(1)
  steps: Step[];

  notes?: string;
  final_metrics?: FinalMetrics;
  continued_trajectory_ref?: string;
  extra?: Record<unknown>;
  subagent_trajectories?: Trajectory[];
}
