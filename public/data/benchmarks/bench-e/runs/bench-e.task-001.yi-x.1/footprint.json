        "content": "def render_table(summary, as_json=False):\n    \"\"\"One row per account, amounts right-aligned, and a total row; or the same as JSON.\"\"\"\n    if as_json:\n        return json.dumps({account: format_amount(cents) for account, cents in summary.items()})\n    width = max([len(account) for account in summary] + [len(\"total\")])\n    rows = [f\"{account:<{width}}  {format_amount(cents):>12}\" for account, cents in summary.items()]\n    rows.append(f\"{'total':<{width}}  {format_amount(sum(summary.values())):>12}\")\n    return \"\\n\".join(rows)\n"
      }
